---
{% assign current_master_key = site.current_year %}
{% assign info_edition_key = site.info_edition | default: site.current_year %}
{
  "current_year": "{{ current_master_key }}",
  "info_edition": "{{ info_edition_key }}",
  "current": {{ site.data.master_info[current_master_key] | jsonify }},
  "info": {{ site.data.master_info[info_edition_key] | default: site.data.master_info[current_master_key] | jsonify }},
  "editions": {{ site.data.master_info | jsonify }}
}
