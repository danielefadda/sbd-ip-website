---
---
{% assign master_info = site.data.master_info['26_27'] %}
{
  "edizione": "{{ master_info.edizione }}",
  "info_generali": {
    "modalita": "{{ master_info.info_generali.modalita }}",
    "orario": "{{ master_info.info_generali.orario }}",
    "lingua": "{{ master_info.info_generali.lingua }}",
    "crediti": {{ master_info.info_generali.crediti }},
    "ore_lezione": {{ master_info.info_generali.ore_lezione }},
    "ore_tirocinio": {{ master_info.info_generali.ore_tirocinio }},
    "costo_totale": {{ master_info.info_generali.costo_totale }},
    "num_partecipanti": {{ master_info.info_generali.num_partecipanti }},
    "num_uditori": {{ master_info.info_generali.num_uditori }}
  },
  "scadenze": [
    {% for item in master_info.scadenze %}
    {
      "voce": "{{ item.voce }}",
      "data": "{{ item.data }}",
      "data_fine": {% if item.data_fine %}"{{ item.data_fine }}"{% else %}null{% endif %},
      "data_label": "{{ item.data_label }}",
      "data_fine_label": {% if item.data_fine_label %}"{{ item.data_fine_label }}"{% else %}null{% endif %},
      "numero_rata": {% if item.numero_rata %}{{ item.numero_rata }}{% else %}null{% endif %},
      "importo": {% if item.importo %}"{{ item.importo }}"{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "sidebar": {{ master_info.sidebar | jsonify }}
}
